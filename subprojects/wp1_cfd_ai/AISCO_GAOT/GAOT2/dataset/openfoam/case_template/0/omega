FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform __OMEGA_INLET__;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform __OMEGA_INLET__;
    }

    outlet
    {
        type            zeroGradient;
    }

    car_surface
    {
        type            omegaWallFunction;
        value           uniform __OMEGA_INLET__;
    }

    ground
    {
        type            omegaWallFunction;
        value           uniform __OMEGA_INLET__;
    }

    top
    {
        type            symmetry;
    }

    sides
    {
        type            symmetry;
    }
}
