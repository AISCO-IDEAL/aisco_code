# .obsidian/

# # Conda
# .conda/

# # Ruff
# .ruff_cache/

# # Pre-commit
# .pre-commit-cache/

# # OS generated files
# .DS_Store
# .DS_Store?
# ._*
# .Spotlight-V100
# .Trashes
# ehthumbs.db
# Thumbs.db

# **/data/
# /aisco_env/

# # Large 3D models and binary assets — prefer Git LFS or external storage
# *.stl
# *.ply
# *.glb
# *.3mf
# *.step
# *.stp

# # Large arrays, model weights, checkpoints
# *.npy
# *.npz
# *.pth
# *.pt
# *.ckpt

# # Pack/index files (git blobs) - normally inside .git but added here as a safeguard
# *.pack
# *.idx

# # Notebook outputs (strip outputs before committing) — ignore large notebooks if you prefer
# *.ipynb

# # Binary build/artifact files
# *.so
# *.o
# *.dll
# *.exe

# # Other large file types seen in repo
# *.glb
# *.3mf



