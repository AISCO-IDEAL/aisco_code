        {
            "type": "extra_group",
            "label": "Bounding Box Constraint",
            "match": "bb.constraint|bounding"
        },
        {
            "type": "extra_group",
            "label": "Mesh Gradients",
            "match": "mesh.gradient|gradient"
        },
        {
            "type": "extra_group",
            "label": "Other",
            "match": ".*"
