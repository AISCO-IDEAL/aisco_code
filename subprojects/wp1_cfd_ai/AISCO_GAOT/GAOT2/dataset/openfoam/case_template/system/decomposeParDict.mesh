FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}

// Mesh-only decomposition: 32 procs optimises snappyHexMesh
// (~47K cells/rank at 1.5M cells vs ~12K at 128 procs).
// The solve step uses system/decomposeParDict (64 procs).
numberOfSubdomains 32;

method scotch;
