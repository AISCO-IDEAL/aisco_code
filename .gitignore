# kdiehl
# new approach, we are using a whitelist
# if a certain file is not synced via gitignore, text me
# gitignore traverses from top to bottom through this file

#######################################################
#ignore everything per default
**
#######################################################

# Whitelist specific files in root
!/.gitattributes
!/.gitignore
!/pyproject.toml
!/setup.py
!/setup.cfg
!/requirements.txt
!/Pipfile
!/.pre-commit-config.yaml
!/tox.ini
!/LICENSE
# Whitelist specific directories and all child directories
!subprojects/
!subprojects/**/
!subprojects/fixed_renderer/build/**
!tests/
!tests/**/
!.github/
!.github/**/
# Whitelist OpenFOAM case template (extensionless dict files have no extension, so
# the file-type whitelist below does not cover them)
!subprojects/**/case_template/**
# Whitelist OpenFOAM case template (extensionless dict files not covered by file-type patterns below)
!subprojects/**/case_template/**
!subprojects/wp7_gui/templates
# Blacklist data folder
subprojects/**/data/
tests/**/data/
# Whitelist file types anywhere in the repo
!**/README.md #
!**/*.py
!**/*.html
#These 3 for cpython and renderign stuff
!**/*.cpp
!**/*.cu
# !**/*.cpython-311-x86_64-linux-gnu.so # should not be overwritten from AISCO-Beast changes
#Needed? check later
!**/*.linux-x86_64-cpython-311
!**/*.md
!**/*.yml
!**/*.yaml
!**/*.rst
!**/*.json
!**/*.toml
!**/*.cfg
!**/*.ini
!**/*.txt
!**/*.sh
!**/*.slurm
!**/*.bat
!**/*.ps1
!**/*.ipynb
!**/*.ui
# Blacklist specific files of a whitelisted file type
pip-log.txt
pip-delete-this-directory.txt

local_settings.py
ipython_config.py

##############################
# Blacklist certain folders entirely
##############################
# Data directories
**/data/         # User-specific data (to be ignored everywhere)
# wandb logging stuff
**/wandb/
# Python-related directories (recursive) can be found anywhere in the directory
**__pycache__/
**/.Python
**/env/
**/venv/
**/ENV/
**/env.bak/
**/venv.bak/
**/aisco_env/
**/aisco_env.egg-info/
**/*.egg-info/
**/.vscode/
**/__pycache__/
**/build/
**/develop-eggs/
**/dist/
**/downloads/
**/eggs/
**/.eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/share/python-wheels/
**/.hypothesis/
**/.pytest_cache/
**/cover/
**/.pybuilder/
**/.pyre/
**/.pytype/
