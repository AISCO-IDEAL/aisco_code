        },
        {
            "type": "extra_group",
            "label": "Solar – Selection",
            "match": "solar.*selection"
        },
        {
            "type": "extra_group",
            "label": "Solar – Quality",
            "match": "solar.*quality"
        },
        {
            "type": "extra_group",
            "label": "Solar – Shading",
            "match": "solar.*shading"
        },
        {
            "type": "extra_group",
            "label": "Solar – Penalty",
            "match": "solar.*penalty"
        },
        {
            "type": "extra_group",
            "label": "Solar – Numerical Factor",
            "match": "solar.*numerical"
        },
        {
            "type": "extra_group",
            "label": "Solar – Receiver Mask",
            "match": "solar.*receiver"
        },
        {
            "type": "extra_group",
