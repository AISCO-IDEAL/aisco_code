# kdiehl
# new approach, we are using a whitelist 
# if a certain file is not synced via gitignore, text me 
# gitignore traverses from top to bottom through this file
#ignore everything per default 
**

# Whitelist all directories (but not their contents yet)
#!**/
# Whitelist some directories and their  contents 
!subprojects/
!subprojects/**/
!tests/
!tests/**/
# Blacklist certain folders entirely 
##############################
# Python-related directories
.Python          # Python environment folders (common in some workflows)
env/             # Virtual environments
venv/            # Virtual environments
ENV/             # Virtual environments
env.bak/         # Backup of virtual environment
venv.bak/        # Backup of virtual environment
AISCO_env/
*.egg-info/
.vscode/
__pycache__/

##############################
# Build/Packaging directories
build/           # Build artifacts
develop-eggs/    # Egg distribution files for Python
dist/            # Distribution files
downloads/       # Downloaded dependencies (e.g., pip)
eggs/            # Eggs (old Python distribution format)
.eggs/           # Hidden egg directories
lib/             # Libraries
lib64/           # 64-bit libraries
parts/           # Parts from build systems
sdist/           # Source distributions
var/             # Variable data
wheels/          # Python Wheel files (package format)
share/python-wheels/  # Shared wheel files

##############################
# Data-related directories (usually user-specific)
**/data/         # User-specific data (to be ignored everywhere)

##############################
# Testing-related directories
.hypothesis/     # Hypothesis test data (used in property-based testing)
.pytest_cache/   # Cache generated by pytest
cover/           # Coverage data (e.g., from pytest-cov)
  
##############################
# Tooling-related directories
.pybuilder/      # PyBuilder build system files
.pyre/           # Pyre type checker files
.pytype/         # PyType type checker files
aisco_env/       # Environment directory for 'aisco' (if specific to your project)

######################

# Whitelist specific files in root
!/.gitignore
!/pyproject.toml
!/setup.py
!/setup.cfg
!/requirements.txt
!/Pipfile
!/.pre-commit-config.yaml
!/tox.ini
!/LICENSE

# Whitelist file types anywhere in the repo
!**/README.md #
!**/*.py
!**/*.md
!**/*.yml
!**/*.yaml
!**/*.rst
!**/*.json
!**/*.toml
!**/*.cfg
!**/*.ini
!**/*.txt
!**/*.sh
!**/*.slurm
!**/*.bat
!**/*.ps1
!**/*.ipynb

# Blacklist specific files of a whitelisted file type
pip-log.txt
pip-delete-this-directory.txt

local_settings.py
ipython_config.py

# useful for explanations? -> no we got Obsidian
#!docs/**/*.md
# !*.csv
# !*.png
# !*.jpg
# !*.jpeg
# !*.svg

