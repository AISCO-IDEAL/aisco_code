FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (-__VINF__ 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (-__VINF__ 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    car_surface
    {
        type            noSlip;
    }

    ground
    {
        type            movingWallVelocity;
        value           uniform (-__VINF__ 0 0);
    }

    top
    {
        type            symmetry;
    }

    sides
    {
        type            symmetry;
    }
}
